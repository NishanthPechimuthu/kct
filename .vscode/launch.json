{
    // VS Code debugger configurations
    "version": "0.2.0",
    "configurations": [

        /* ------------------- Python ------------------- */
        {
            "name": "Python: Current File",
            "type": "python",                     // correct type
            "request": "launch",
            "program": "${file}",                 // file you have open
            "console": "integratedTerminal",      // run in VS Code terminal
            "justMyCode": true,
            "python": "${command:python.interpreterPath}"   // always use the selected interpreter
        }
    ]
}